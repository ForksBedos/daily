# Секреты проекта UzDigest. Скопируйте в .env и заполните. .env не коммитить.

# Токен подписки Claude. Получить: `claude setup-token` (под аккаунтом, чья подписка используется).
CLAUDE_CODE_OAUTH_TOKEN=

# Токен Telegram-бота. Получить: @BotFather → /newbot. Пользователи бота — в config/settings.yaml (bot.users).
TELEGRAM_BOT_TOKEN=
